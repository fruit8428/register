#!/bin/bash
# 國際扶輪 3523 地區 2026-27 年度保齡球聯誼賽 - 網頁版管理儀表板啟動器

cd "$(dirname "$0")"

echo "========================================================"
echo " 正在啟動 扶輪保齡球聯誼賽 網頁版管理系統..."
echo "========================================================"

# 在背景延遲 1 秒自動開啟瀏覽器
(sleep 1 && open "http://127.0.0.1:5001") &

# 啟動 Flask 網頁伺服器
if [ -f ".venv/bin/python3" ]; then
    .venv/bin/python3 web_app.py
else
    python3 web_app.py
fi
