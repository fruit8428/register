#!/bin/bash
# 國際扶輪 3523 地區 2026-27 年度保齡球聯誼賽 - 自動對帳與名冊統計啟動器

cd "$(dirname "$0")"

echo "========================================================"
echo " 正在啟動 扶輪保齡球聯誼賽 AI 郵件對帳與名單統計系統..."
echo "========================================================"

if [ -f ".venv/bin/python3" ]; then
    .venv/bin/python3 bowling_assistant.py
else
    python3 bowling_assistant.py
fi

echo ""
echo "========================================================"
echo " 同步完成。請檢視上方報告。"
echo " 報名統計表: 報名統計.xlsx"
echo " 參賽名單表: 附件四.xlsx"
echo "========================================================"
read -p "按 Enter 鍵關閉此視窗..."
